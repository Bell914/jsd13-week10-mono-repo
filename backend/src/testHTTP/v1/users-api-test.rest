@baseUrl = http://localhost:3001/api/v1

### Read all users
GET {{baseUrl}}/users


### Create a new user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "username": "Charlie2",
  "email": "charlie2@example.com",
  "password": "pass123"
}


### Update a user
PUT {{baseUrl}}/users/1
Content-Type: application/json

{
  "username": "Ittikorn",
  "email": "Ittikorn@example.com",
  "password": "pass123"
}


### Delete a user
DELETE {{baseUrl}}/users/1


### Trigger 400 validation error (Missing body fields)
PUT {{baseUrl}}/users/1
Content-Type: application/json

{}


### Trigger 404 error (User not found)
GET {{baseUrl}}/users/999
